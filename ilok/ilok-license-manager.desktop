[Desktop Entry]
Name=iLok License Manager
Comment=PACE License Support — authorise iLok-protected software (Wine, ableton-wine stack)
Exec=ilok %f
Type=Application
StartupNotify=true
# Wine sets WM_CLASS to the exe filename (without .exe). MUST match exactly
# or Hyprland cannot bind the window to layer rules — the Qt5 surface lands
# on the unclassified default layer (fullscreen-blur shader) instead of a
# normal floating window.
StartupWMClass=iLok License Manager.exe
Categories=AudioVideo;Audio;
