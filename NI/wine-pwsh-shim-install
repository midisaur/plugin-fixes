#!/usr/bin/env bash
# wine-pwsh-shim-install — patch the Wine loader stub and prefix copy of
# `powershell.exe` so the Native Access 2 installer (NSIS) can finish its
# "is Native Access running?" preflight check.
#
# Background: Wine's `powershell.exe` is a builtin command. Both the
# Wine loader stub at $WINE_TREE/lib/wine/x86_64-windows/powershell.exe
# and the on-disk fallback at $WINEPREFIX/drive_c/windows/.../powershell.exe
# are 28 KB stubs that IGNORE their -C argument and always exit 0. The
# NA 2 installer uses powershell.exe -C to check whether NA is already
# running and loops the "Native Access is running" dialog forever when
# the stub lies. This shim returns exit 1 ("not running") so the
# installer proceeds, then we restore the original stubs.
#
# Reproducible, Wine-update-safe: re-run this script after any Wine
# tree update that re-installs the loader stub. It backs up originals
# to <file>.wine-stub.bak the first time and is a no-op on subsequent
# runs (idempotent if shim is already in place).
#
# Requirements:
#   - x86_64-w64-mingw32-gcc (apt: gcc-mingw-w64-x86-64-win32)
#   - ~/.wine-ableton/ prefix (or pass WINEPREFIX= and WINE_TREE=)

set -euo pipefail

WINE_TREE="${WINE_TREE:-$HOME/.local/opt/wine-d2d1-nspa-11.11}"
WINEPREFIX="${WINEPREFIX:-$HOME/.wine-ableton}"

if [[ ! -x "$WINE_TREE/bin/wine" ]]; then
    echo "error: wine binary not found at $WINE_TREE/bin/wine" >&2
    echo "       set WINE_TREE=/path/to/wine" >&2
    exit 1
fi
if [[ ! -d "$WINEPREFIX/drive_c" ]]; then
    echo "error: WINEPREFIX does not look like a wine prefix: $WINEPREFIX" >&2
    exit 1
fi
if ! command -v x86_64-w64-mingw32-gcc >/dev/null; then
    echo "error: x86_64-w64-mingw32-gcc not found" >&2
    echo "       apt install gcc-mingw-w64-x86-64-win32" >&2
    exit 1
fi

# 1) Build (or rebuild) the shim
SHIM_SRC=$(mktemp --suffix=.c)
SHIM_BIN=$(mktemp --suffix=.exe)
trap 'rm -f "$SHIM_SRC" "$SHIM_BIN"' EXIT
cat > "$SHIM_SRC" <<'EOF'
#include <stdlib.h>
#include <string.h>
int main(int argc, char **argv) {
    /* The NA installer loop calls:
     *   powershell.exe -C "if ((Get-CimInstance ...startsWith 'C:\\Program Files\\Native Instruments\\Native Access'...Count -gt 0) { exit 0 } else { exit 1 }"
     * For that specific script we must return 1 (NA is NOT running) to break the loop.
     * For every other powershell call (NA's dep check, anything else) we mimic the
     * original Wine stub's behavior: do nothing, return 0. The dep check is satisfied
     * by the actual installed msvcp140/vcruntime140 DLLs; the script just queries
     * them via powershell cmdlets. Returning 0 = "command ran" lets NA proceed.
     */
    int i, found_native = 0, found_cim = 0, found_starts = 0;
    for (i = 0; i < argc; i++) {
        if (!argv[i]) continue;
        if (strstr(argv[i], "Native Access")) found_native = 1;
        if (strstr(argv[i], "Get-CimInstance")) found_cim = 1;
        if (strstr(argv[i], "StartsWith")) found_starts = 1;
    }
    if (found_native && found_cim && found_starts) return 1;  /* installer loop check */
    return 0;  /* everything else: behave like the Wine stub (no-op success) */
}
EOF
x86_64-w64-mingw32-gcc -O2 -s -o "$SHIM_BIN" "$SHIM_SRC"

# 2) Patch every powershell.exe that could be invoked:
#    a) the Wine loader stub (this is the one the installer actually hits)
#    b) the on-disk fallback in drive_c/.../system32
#    c) the on-disk fallback in drive_c/.../syswow64 (32-bit; some installers use it)
patch_one() {
    local f="$1" desc="$2"
    if [[ ! -f "$f" ]]; then
        echo "  - $desc: $f (missing, skipping)"
        return
    fi
    # If the file is already our shim, no-op
    if cmp -s "$f" "$SHIM_BIN"; then
        echo "  - $desc: already patched"
        return
    fi
    # If we have a backup, the stub was already replaced once; just overwrite
    if [[ -f "$f.wine-stub.bak" ]]; then
        cp -f "$SHIM_BIN" "$f"
        echo "  - $desc: re-patched (backup at .wine-stub.bak)"
    else
        cp -p "$f" "$f.wine-stub.bak"
        cp -f "$SHIM_BIN" "$f"
        echo "  - $desc: patched (backup at .wine-stub.bak)"
    fi
}

echo "Patching powershell.exe shims (WINE_TREE=$WINE_TREE, WINEPREFIX=$WINEPREFIX):"
patch_one "$WINE_TREE/lib/wine/x86_64-windows/powershell.exe" "wine-loader-64"
patch_one "$WINEPREFIX/drive_c/windows/system32/WindowsPowerShell/v1.0/powershell.exe" "prefix-system32"
patch_one "$WINEPREFIX/drive_c/windows/syswow64/WindowsPowerShell/v1.0/powershell.exe" "prefix-syswow64"

# 3) Sanity: launching powershell.exe should now exit 1
echo
echo "Sanity check: WINEPREFIX=$WINEPREFIX $WINE_TREE/bin/wine powershell.exe -C 'exit 7'"
if WINEPREFIX="$WINEPREFIX" "$WINE_TREE/bin/wine" powershell.exe -C 'exit 7' >/dev/null 2>&1; then
    echo "  WARNING: shim returned 0 (expected 1). Patch may not have applied."
    exit 2
else
    echo "  OK: shim returned 1."
fi

cat <<'EOF'

Done. To run the Native Access 2 installer:

  WINEPREFIX=~/.wine-ableton ~/.local/opt/wine-d2d1-nspa-11.11/bin/wine \
      /path/to/Native-Access_2.exe

After the install completes, restore the originals (revert the loop) with:

  wine-pwsh-shim-restore
EOF
